# Android no longer goes through fastlane/supply — Gradle Play Publisher (see androidApp's
# play {} block) authenticates via Workload Identity Federation directly, which fastlane's
# Ruby auth stack doesn't reliably support yet (open upstream bug: missing client_email when
# fed a WIF token instead of a service-account key).
default_platform(:ios)

platform :ios do
  desc "Build a release archive and push it to TestFlight"
  lane :beta do
    # Captured up front as absolute paths — some actions (namely match, which clones the certs
    # repo into a temp dir) can leave the process cwd in a different place than where the lane
    # started, so relative paths like "../iosApp/iosApp.xcodeproj" resolve inconsistently
    # between local runs and CI.
    xcodeproj_path = File.expand_path("../iosApp/iosApp.xcodeproj")
    build_output_dir = File.expand_path("../build/ios")

    setup_ci if ENV["CI"]

    match(type: "appstore", api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"])

    # match provisions with manual signing; the checked-in project uses Automatic locally, so
    # switch it to the match-provided identity/profile for this CI run only — nothing here is
    # ever committed back, the checkout is thrown away at the end of the job.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj_path,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "ke.co.smartroundclinic.patientapp",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["ke.co.smartroundclinic.patientapp"],
      team_id: ENV["APPLE_TEAM_ID"] || "65X556349W",
    )

    if ENV["IOS_BUILD_NUMBER"]
      increment_build_number(
        xcodeproj: xcodeproj_path,
        build_number: ENV["IOS_BUILD_NUMBER"],
      )
    end

    build_app(
      project: xcodeproj_path,
      scheme: "iosApp",
      export_method: "app-store",
      output_directory: build_output_dir,
    )

    upload_to_testflight(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      skip_waiting_for_build_processing: true,
    )
  end
end
